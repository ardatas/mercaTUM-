{
  "name": "mercatum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node --env-file-if-exists=.env dist/server/index.js"
  },
  "dependencies": {
    "@bsv/sdk": "3.2.1",
    "@bsv/wallet-toolbox": "2.14.9",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "express": "5.3.0",
    "knex": "3.3.0",
    "lucide-react": "1.65.0",
    "motion": "14.9.0",
    "openai": "7.46.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/diff": "8.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
